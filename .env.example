# ---- API Keys (set the ones needed for your chosen provider) ----
# OpenAI (required for MODEL_PROVIDER=openai)
OPENAI_API_KEY=sk-...
# Ollama cloud (required when OLLAMA_API_KEY is set or :cloud suffix used)
# OLLAMA_API_KEY=...
# Tavily search (required for web research tool)
TAVILY_API_KEY=tvly-...
# Either LANGSMITH_API_KEY or LANGCHAIN_API_KEY works (for tracing)
LANGSMITH_API_KEY=lsv2_...

# ---- LangSmith tracing (auto-enabled when set) ----
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=auto-research-self-improving

# ---- Model configuration ----
# Uses init_chat_model() — supports 20+ providers.
MODEL=gpt-4o
MODEL_PROVIDER=openai
# Optional: custom base URL
# MODEL_BASE_URL=http://localhost:11434

# ---- Evolution settings ----
MAX_EVOLUTION_CYCLES=5
BATCH_SIZE=3

# ---- Outer loop (autoresearch) settings ----
# Enable the two-speed evolution: inner loop self-evolves, outer loop makes code changes
OUTER_LOOP_ENABLED=true
# Maximum inner loop cycles before signaling plateau to outer loop
MAX_INNER_CYCLES=5
# Minimum score improvement to consider progress (inner loop plateau detection)
MIN_IMPROVEMENT_THRESHOLD=0.05

# ---- Directory paths (relative to project root) ----
SKILLS_DIR=skills
PROMPTS_DIR=prompts
MEMORY_DIR=memory
EVOLUTION_STATE_DIR=evolution_state
